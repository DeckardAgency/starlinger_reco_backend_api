# =============================================================================
# Production/staging environment template — COPY, DO NOT COMMIT REAL VALUES.
#
# The committed .env holds only safe, non-secret defaults (secrets are blank).
# Real secrets must come from the environment: either a gitignored .env.local
# on the server, or (preferred) real OS environment variables / a secrets vault
# injected by the platform (Cloudways, Docker, systemd, etc.).
#
# Generate a fresh APP_SECRET per environment:  php -r "echo bin2hex(random_bytes(24));"
# =============================================================================

# Run the framework in production mode (disables the dev profiler, stack traces,
# verbose errors, and the /api/docs schema for anonymous users).
APP_ENV=prod

# Unique per environment. NEVER reuse the dev value or share across environments.
APP_SECRET=__CHANGE_ME__generate_with_random_bytes

# The JWT private key passphrase. Must match the passphrase the keypair in
# config/jwt was generated with. To rotate: regenerate the keypair
# (bin/console lexik:jwt:generate-keypair) AND set the new passphrase here — note
# this invalidates all outstanding access tokens.
JWT_PASSPHRASE=__CHANGE_ME__jwt_key_passphrase

# MUST be true in production (https) so the auth cookies carry the Secure flag.
JWT_COOKIE_SECURE=true

# CORS: anchored regex of allowed frontend origins. The committed default only
# matches localhost — production MUST list the real admin + customer origins, e.g.:
# CORS_ALLOW_ORIGIN='^https://(admin|shop)\.starlinger\.example\.com$'
CORS_ALLOW_ORIGIN='^https://REPLACE-WITH-YOUR-FRONTEND-ORIGINS$'

# Production database.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME?serverVersion=8.0&charset=utf8mb4"

# Real outbound mailer (the dev default points at a local mailcatcher on :1025).
MAILER_DSN=smtp://USER:PASSWORD@smtp.example.com:587

# Carrier integration.
DHL_API_KEY=__CHANGE_ME__

# Public URLs of the deployed frontends. CLIENT_APP_URL is embedded in
# password-reset and invitation emails — if it points at localhost, those
# emails link nowhere. DEFAULT_URI is used for absolute URLs generated
# outside HTTP requests (CLI/worker-rendered emails).
CLIENT_APP_URL=https://REPLACE-customer-frontend.example.com
ADMIN_APP_URL=https://REPLACE-admin-frontend.example.com
DEFAULT_URI=https://REPLACE-api-host.example.com

# Where order notifications go / are sent from.
ORDER_ADMIN_EMAIL=__CHANGE_ME__
ORDER_SENDER_EMAIL=__CHANGE_ME__

# Async transport for order/email messages (the invitation & order handlers use
# Messenger). doctrine:// works but a real broker is recommended in production.
# MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
