<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Tracking update</title>
</head>
<body style="font-family: 'Inter', Arial, sans-serif; color:#232323;">
    <div style="max-width:600px;margin:0 auto;padding:24px;">
        <p>Dear {{ user.fullName ?? 'Customer' }},</p>

        <p>There is an update on your Starlinger order #{{ order.orderNumber ?? order.id }}.</p>

        <div style="margin:20px 0;padding:16px;border:1px solid #e4e4e7;border-radius:8px;">
            <p style="margin:0 0 8px;font-weight:600;">Current status:</p>
            <p style="margin:0 0 4px;font-size:16px;">{{ event.status|replace({'_': ' '})|capitalize }}</p>
            {% if event.location %}
                <p style="margin:0 0 4px;color:#71717a;">Location: {{ event.location }}</p>
            {% endif %}
            {% if event.description %}
                <p style="margin:0;color:#71717a;">{{ event.description }}</p>
            {% endif %}
        </div>

        {% if order.trackingUrl %}
            <p>
                <a href="{{ order.trackingUrl }}" target="_blank" rel="noopener"
                   style="display:inline-block;padding:10px 18px;background:#232323;color:#fff;text-decoration:none;border-radius:6px;font-weight:500;">
                    Track your shipment
                </a>
            </p>
        {% endif %}

        <p style="color:#71717a;font-size:13px;margin-top:32px;">
            This is an automated notification from Starlinger.
        </p>
    </div>
</body>
</html>
