# Committed prod defaults. Symfony's load order is .env -> .env.local -> .env.prod,
# the latter winning, so these override stale values in the server's .env.local.
# Only real OS-level environment variables rank higher than this file.

# The auth cookies are SameSite=None; Partitioned in prod (see
# lexik_jwt_authentication.yaml / gesdinet_jwt_refresh_token.yaml) and browsers
# reject both attributes without Secure. Prod is HTTPS-only, so this is safe.
JWT_COOKIE_SECURE=true

# The SPAs call this API cross-origin from their Vercel domains (the Vercel /api
# proxy was removed because its datacenter egress IPs tripped Imunify360
# bot-protection on the host).
CORS_ALLOW_ORIGIN='^https://(starlinger-reco-client|starlinger-reco-admin-client)\.vercel\.app$'
